from flask import Flask, request, jsonify

app = Flask(__name__)

@app.route("/api/report", methods=["POST"])
def submit_report():
    data = request.get_json() or {}
    reason = data.get("reason")
    details = data.get("details")

    if not reason:
        return jsonify({"status": "error", "message": "Reason is required"}), 400

    # Save to database or alert admin via email/Slack webhook
    print(f"NEW REPORT RECEIVED: {reason} - {details}")

    return jsonify({"status": "success", "message": "Report received. Thank you!"})
